{
  "name": "brainding-lens",
  "version": "0.1.0",
  "description": "Add the logo of your company, team, the infrastructure your clusters run on, or your reseller to Lens's top bar as your brand.",
  "keywords": [
    "lens-extension"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "lensExtension": {
    "icon": "assets/brand-icon.svg",
    "banner": "assets/brand-banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/"
  },
  "dependencies": {
    "@k8slens/element-components": "^3.9.0",
    "@k8slens/feature-core": "^7.4.0",
    "@k8slens/injectable": "^26.0.0",
    "@k8slens/input-components": "^1.0.1",
    "@k8slens/notifications-contracts": "^1.0.2",
    "@k8slens/persistable-contracts": "^1.0.2",
    "@k8slens/preferences-contracts": "^2.0.0",
    "@k8slens/status-bar-contracts": "^1.0.0",
    "@k8slens/stylesheet-contracts": "^1.0.0",
    "@k8slens/top-bar-contracts": "^1.0.2",
    "@k8slens/use-inject": "^1.0.2",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.0.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "rimraf": "^4.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yruizmir/branding-lens.git"
  },
  "bugs": "https://github.com/yruizmir/branding-lens/issues"
}
